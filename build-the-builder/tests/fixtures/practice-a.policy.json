      {
        "document": "document_1",
        "sha256": "d57c049c89aec4615f5b939c5a96ee9bd194142d17045bc4036615cfbdf0f1c7",
        "start_line": 41,
        "end_line": 41,
        "quote": "12. A wrong answer may be asked again. Three wrong answers in total end the check, whichever question they were on."
      }
    ],
