,\r\n    {\r\n        \"Name\":  \"17-test-environment-test-customers-json.md\",\r\n        \"Length\":  707318\r\n    },\r\n    {\r\n        \"Name\":  \"18-test-environment-test-customers-md.md\",\r\n        \"Length\":  7740\r\n    }\r\n]\r\n","exit_code":0,"status":"completed"}}
