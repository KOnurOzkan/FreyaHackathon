at turn or a real call cannot start. Set the model and save once more.\r\n      w = api(\"GET\", f\"/api/v2/workflow/{workflow_id}\", workspaceId=workspace_id())[\"workflow\"][\"workflow\"]\r\n      ac = w.get(\"agent_config\") or {}; llm = ac.get(\"llmConfig\") or {}\r\n      if (llm.get(\"provider\"), llm.get(\"model\")) != (AGENT_LLM[\"provider\"], AGENT_LLM[\"model\"]):\r\n          ac[\"llmConfig\"] = {**llm, **AGENT_LLM}; api(\"PUT\", f\"/api/v2/workflow/{workflow_id}\", {\"workflow\": {**w, \"age\r\nnt_config\": ac}})\r\n      vs = api(\"GET\", f\"/api/v2/versions/workflow/{workflow_id}\", workspaceId=workspace_id())[\"versions\"]\r\n      newest = max(vs, key=lambda v: v[\"versionNumber\"])\r\n      if not newest.get(\"isPublished\"): api(\"POST\", f\"/api/v2/versions/workflow/{workflow_id}/publish\", {\"versionId\": n\r\newest[\"id\"]})\r\n      return newest[\"versionNumber\"]\r\n  def export_workflow(workflow_id, path):\r\n      \"\"\"Write the workflow as it is on the platform to a file. This file is part of what you submit.\"\"\"\r\n      w = api(\"GET\", f\"/api/v2/workflow/{workflow_id}\", workspaceId=workspace_id())[\"workflow\"]\r\n      open(path, \"w\").write(json.dumps({\"workflow_id\": w[\"id\"], \"agent_id\": w.get(\"agentId\"), \"updated_at\": w.get(\"upda\r\ntedAt\"), \"workflow\": w[\"workflow\"]}, indent=1)); return path\r\n  def create_personas(personas):        return api(\"POST\", \"/api/v2/personas\", {\"personas\": personas})\r\n> def get_iteration(sim_id, it_id):\r\n      \"\"\"One iteration with ALL its runs. The route returns 30 runs by default and 100 at most, so this reads page by p\r\nage.\"\"\"\r\n      out, off = None, 0\r\n      while True:\r\n          r = api(\"GET\", f\"/api/v2/simulations/{sim_id}/iterations/{it_id}\", limit=100, offset=off)\r\n          if out is None: out = r\r\n          else: out[\"runs\"] += r[\"runs\"]\r\n          off += 100\r\n          if len(r[\"runs\"]) < 100: return out\r\n> def get_call(call_id):\r\n      \"\"\"One simulated call: `messages` holds the transcript, tool calls included. Run ids and call ids come from get_i\r\nteration()['runs'].\"\"\"\r\n      return api(\"GET\", f\"/api/v2/call/{call_id}\")[\"call\"]\r\n  \r\n  # The model every team's phone agent runs on: Freya's model on the event's own GPU box. Do not change it. (Organisers\r\n can point a test at another model with the two variables.)\r\n  AGENT_LLM = {\"provider\": os.environ.get(\"FREYA_AGENT_PROVIDER\", \"experimental-5\"), \"model\": os.environ.get(\"FREYA_AGE\r\nNT_MODEL\", \"experimental-5\")}\r\n  SIM_LLM = {\"provider\": \"google\", \"model\": \"gemini-3-flash-preview\"}        # plays the customer and judges\r\n  \r\n> def run_simulation(agent_id, name, variables_by_persona, max_seconds=420, concurrency=int(os.environ.get(\"FREYA_SIM_C\r\nONCURRENCY\", \"5\"))):\r\n      \"\"\"Start a text simulation, wait for it, return (simulation_id, iteration_id).\"\"\"\r\n      while True:                      # a workspace runs one simulation at a time: wait for the running one instead of\r\n failing\r\n          try:\r\n              sim = api(\"POST\", \"/api/v2/simulations\", {\r\n                  \"agentId\": agent_id, \"name\": name, \"mode\": \"chat\", \"selectedPersonaIds\": list(variables_by_persona),\r\n                  \"customerVariablesMap\": variables_by_persona, \"maxConcurrentCalls\": concurrency, \"runsPerPersona\": 1,\r\n \"maxCallDurationSeconds\": max_seconds,\r\n                  \"assistantLlmOverride\": AGENT_LLM, \"routingLlmOverride\": AGENT_LLM, \"extractionLlmOverride\": AGENT_LL\r\nM,\r\n                  \"personaLlmOverride\": SIM_LLM, \"analysisLlmOverride\": SIM_LLM})\r\n              break\r\n          except RuntimeError as e:\r\n              if \"concurrent simulations\" not in str(e): raise\r\n              print(\"another simulation is running in this workspace, waiting 30 s\", flush=True); time.sleep(30)\r\n      sim_id = (sim.get(\"simulation\") or sim)[\"id\"]\r\n      while True:\r\n          time.sleep(10)\r\n          s = api(\"GET\", f\"/api/v2/simulations/{sim_id}\"); s = s.get(\"simulation\") or s\r\n          if s.get(\"status\") in (\"completed\", \"failed\", \"paused\"): break\r\n      its = api(\"GET\", f\"/api/v2/simulations/{sim_id}/iterations\"); its = its.get(\"iterations\") or its.get(\"items\") or \r\nits\r\n      return sim_id, its[0][\"id\"], s.get(\"status\")\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
